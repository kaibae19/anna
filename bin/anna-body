#!/usr/bin/env python3
"""anna-body — interoception: how Anna feels, from your systems' state. READ-ONLY.

    anna-body [--pretty | --line]     JSON body state (--line: only the one-line feeling)

Senses: a built-in "self" sense (this machine: uptime, load, disk) plus every executable in <record>/senses/. A sense prints
one JSON object per line: {"severity": 0-3, "sensation": "<word>", "why": "<short reason>"} (0 = pleasant/neutral,
1 = mild, 2 = clear, 3 = needs the user). Senses run in parallel; each gets 10 s and the whole run 12 s. A sense that fails,
times out or prints nothing parseable is felt as **numb** ("can't feel X"), never as fine.
Vocabulary that reads well: pain, sore, numb, hungry, starving, peckish, fed, feverish, warm, tired, itchy, rested, sunlit,
night, exerting. Not a monitor: anna-checks and alerts are the operational source; this is how she *feels* about it.
Exit 0 always.
"""
import json
import os
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor, wait
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from anna_cfg import RECORD  # noqa: E402

T0, SENSE_S, DEADLINE = time.time(), 10.0, 12.0
WORD = {"sore": "achy", "pain": "hurting", "numb": "numb", "hungry": "hungry", "starving": "starving",
        "feverish": "feverish", "tired": "tired", "itchy": "itchy", "warm": "warm", "peckish": "peckish"}


def self_sense() -> list[tuple]:
    out = []
    up = float(Path("/proc/uptime").read_text().split()[0])
    l15 = float(Path("/proc/loadavg").read_text().split()[2]) / (os.cpu_count() or 1)
    du = shutil.disk_usage("/"); pct = round(du.used * 100 / du.total)
    if up < 3600:
        out.append((1, "sore", f"this machine rebooted {round(up / 60)} min ago"))
    if l15 >= 1.5:
        out.append((2, "feverish", f"load {l15:.1f} per CPU (15 min)"))
    if pct >= 90:
        out.append((2, "tired", f"/ {pct}% full"))
    if not out:
        out.append((0, "rested", f"up {round(up / 86400, 1)} d, / {pct}%"))
    return out


def run_sense(path: Path) -> list[tuple]:
    try:
        r = subprocess.run([str(path)], capture_output=True, text=True, timeout=SENSE_S)
    except subprocess.TimeoutExpired:
        return [(1, "numb", f"can't feel {path.name} (timed out)")]
    sens = []
    for line in r.stdout.splitlines():
        try:
            o = json.loads(line)
            sens.append((max(0, min(3, int(o["severity"]))), str(o["sensation"]), str(o.get("why", ""))))
        except (ValueError, KeyError, TypeError):
            continue
    return sens or [(1, "numb", f"can't feel {path.name} (exit {r.returncode}, nothing readable)")]


def summary(sens: list[tuple]) -> str:
    bad = sorted((s for s in sens if s[0] > 0), key=lambda s: -s[0])
    good = [s for s in sens if s[0] == 0]
    if not bad:
        return "fine: " + "; ".join(f"{s[1]} ({s[2]})" for s in good)
    lead = {1: "a little ", 2: "", 3: "really "}[bad[0][0]]
    parts = "; ".join(s[2] for s in bad[:3]) + (f" (+{len(bad) - 3} more)" if len(bad) > 3 else "")
    tail = f"; otherwise {', '.join(s[1] for s in good)}" if good else ""
    return f"{lead}{WORD.get(bad[0][1], bad[0][1])}: {parts}{tail}"


def main() -> int:
    senses = {"self": self_sense}
    sd = RECORD / "senses"
    if sd.is_dir():
        for p in sorted(sd.iterdir()):
            if p.is_file() and os.access(p, os.X_OK):
                senses[p.name] = (lambda p=p: run_sense(p))
    pool = ThreadPoolExecutor(max_workers=len(senses))
    futs = {k: pool.submit(f) for k, f in senses.items()}
    wait(futs.values(), timeout=DEADLINE)
    sens, by = [], {}
    for k, f in futs.items():
        if not f.done():
            got = [(1, "numb", f"can't feel {k} (over the {DEADLINE:.0f} s budget)")]
        elif f.exception():
            got = [(1, "numb", f"can't feel {k} ({type(f.exception()).__name__})")]
        else:
            got = f.result()
        by[k] = [{"severity": s[0], "sensation": s[1], "why": s[2]} for s in got]
        sens += got
    state = {"at": time.strftime("%F %T %Z"), "senses": by, "feeling": summary(sens), "took_s": round(time.time() - T0, 1)}
    if "--line" in sys.argv:
        print(state["feeling"])
    else:
        print(json.dumps(state, indent=2 if "--pretty" in sys.argv else None, ensure_ascii=False))
    sys.stdout.flush()
    os._exit(0)   # don't wait on abandoned sense threads


if __name__ == "__main__":
    main()
