#!/bin/bash
# anna-clock — Anna's own schedule. Files canonical: <record>/clock/YYYY-MM.md (by due month), one line per item.
#   anna-clock add WHEN [--ping|--run] TEXT   WHEN: "2026-10-21", "2026-10-21 09:00", "tomorrow 09:00", "mon", "+3d", "+2h", "+90min"
#                                             no flag = note (shows in the morning check from its day on)
#                                             --ping = tell the user at that time (anna-tell send, importance high: never held)
#                                             --run = a headless anna-run with TEXT as the task
#   anna-clock list [--all]                   open items (--all: every line, closed included)
#   anna-clock due [--days N]                 open items due by today+N (overdue included)
#   anna-clock done ID [note] | cancel ID [note]
#   anna-clock tick                           fire due ping/run items (anna-clock.timer, every 5 min; catches up after downtime)
# Line: "- [ ] 2026-10-21 09:00 ping #a3f2 text (added 2026-10-18 by session)"; date-only items have "--:--".
# States: [ ] open · [x] done/fired · [-] cancelled. Each change commits just that month file (push best-effort).
# Config: anna.timezone, anna.user, paths.record, paths.state, paths.bin. $ANNA_CLOCK_BY names who added an item.
set -euo pipefail
cfg() { "$(dirname "$(readlink -f "$0")")/anna-config" "$1"; }
export TZ; TZ=$(cfg anna.timezone)
BIN=$(cfg paths.bin); export PATH="$BIN:$HOME/.local/bin:$PATH"
R=$(cfg paths.record); C=$R/clock; ST=$(cfg paths.state); WHO=$(cfg anna.user)
mkdir -p "$C" "$ST"; exec 9>"$ST/clock.lock"; flock -w 30 9   # tick vs add vs the bot
now_d=$(date +%F); now_t=$(date +%H:%M)
re='^- \[( |x|-)\] ([0-9]{4}-[0-9]{2}-[0-9]{2}) ([0-9]{2}:[0-9]{2}|--:--) (note|ping|run) #([0-9a-f]{4}) (.*)$'
stream() { command -v anna-stream >/dev/null && anna-stream add --from "$1" "$2" 2>/dev/null || true; }

commit() {  # commit one clock file if the record is a git repo; push best-effort
  git -C "$R" rev-parse --git-dir >/dev/null 2>&1 || return 0
  local f=${1#"$R"/}
  git -C "$R" add -- "$f" && git -C "$R" commit -q -m "clock: $2" -- "$f" >/dev/null
  if git -C "$R" remote | grep -q .; then git -C "$R" push -q 2>/dev/null || echo "anna-clock: committed; push failed" >&2; fi
}
open_lines() { cat "$C"/[0-9]*.md 2>/dev/null | grep -E '^- \[ \] ' | sort -k4,5 || true; }
show() { while IFS= read -r l; do [[ $l =~ $re ]] &&
  printf '#%s %s %s %-4s %s\n' "${BASH_REMATCH[5]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}" "${BASH_REMATCH[6]}"
  done; }
# an item's own id is the field after its action; "#id" elsewhere in a line (another item named in the text) never matches
ID_AT='[0-9]{4}-[0-9]{2}-[0-9]{2} ([0-9]{2}:[0-9]{2}|--:--) (note|ping|run) #'
find_id() { [[ $1 =~ ^#?[0-9a-f]{4}$ ]] || { echo "anna-clock: bad id '$1'" >&2; exit 2; }
  grep -lE "^- \[ \] $ID_AT${1#\#} " "$C"/[0-9]*.md 2>/dev/null | head -1; }
mark() {  # mark FILE ID STATE SUFFIX: close one open line (awk via ENVIRON, so / & \ in the suffix stay literal)
  ID=$2 ST=$3 SUF=$4 AT=$ID_AT awk 'BEGIN{p="^- \\[ \\] " ENVIRON["AT"] ENVIRON["ID"] " "}
    $0 ~ p {sub(/^- \[ \]/, "- [" ENVIRON["ST"] "]"); $0 = $0 " — " ENVIRON["SUF"]} {print}' "$1" > "$1.tmp" && mv "$1.tmp" "$1"; }
close() {  # close ID MARK SUFFIX
  local id=${1#\#} f; f=$(find_id "$1"); [ -n "$f" ] || { echo "anna-clock: no open item #$id" >&2; exit 1; }
  mark "$f" "$id" "$2" "$3"; commit "$f" "#$id $3"; grep -E "^- \[.\] $ID_AT$id " "$f"
  stream clock "#$id $3"; }

case "${1:-}" in
add)
  shift; when=${1:?usage: anna-clock add WHEN [--ping|--run] TEXT}; shift
  act=note; case "${1:-}" in --ping) act=ping; shift ;; --run) act=run; shift ;; esac
  text="$*"; text=${text//$'\n'/ }; [ -n "$text" ] || { echo "anna-clock: no text" >&2; exit 2; }
  w=$(sed -E 's/^\+([0-9]+)d$/+\1 days/; s/^\+([0-9]+)h$/+\1 hours/; s/^\+([0-9]+)min$/+\1 minutes/' <<<"$when")
  ts=$(date -d "$w" '+%F %H:%M') || { echo "anna-clock: can't read WHEN '$when'" >&2; exit 2; }
  d=${ts% *}; t=${ts#* }
  [[ $when =~ [0-9]:[0-9]|^\+[0-9]+(h|min)$ ]] || t=--:--          # no clock time given → date-only
  [ "$t" = --:-- ] && [ "$act" != note ] && { echo "anna-clock: --$act needs a time (e.g. \"$when 09:00\")" >&2; exit 2; }
  [[ "$d $t" < "$now_d $now_t" && $t != --:-- ]] && { echo "anna-clock: $d $t is in the past" >&2; exit 2; }
  by=${ANNA_CLOCK_BY:-session}
  while id=$(od -An -N2 -tx2 /dev/urandom | tr -d ' '); grep -q " #$id " "$C"/*.md 2>/dev/null; do :; done
  f=$C/${d:0:7}.md
  [ -f "$f" ] || printf '# Anna'"'"'s clock: %s\n\nFormat and tool: `clock/README.md`.\n\n' "${d:0:7}" > "$f"
  echo "- [ ] $d $t $act #$id $text (added $now_d by $by)" >> "$f"
  commit "$f" "add #$id $d $t $act"; echo "added #$id $d $t $act: $text"
  stream "clock ($by)" "scheduled #$id $d $t $act: $text" ;;
list)
  if [ "${2:-}" = --all ]; then cat "$C"/[0-9]*.md 2>/dev/null | grep -E '^- \[' || echo "(empty)"
  else o=$(open_lines | show); echo "${o:-(nothing scheduled)}"; fi ;;
due)
  n=0; [ "${2:-}" = --days ] && n=${3:?days}; lim=$(date -d "+$n days" +%F)
  o=$(open_lines | awk -v l="$lim" '$4 <= l' | show); echo "${o:-(nothing due)}" ;;
done)   close "${2:?id}" x "done $now_d${3:+: ${*:3}}" ;;
cancel) close "${2:?id}" - "cancelled $now_d${3:+: ${*:3}}" ;;
tick)
  open_lines | while IFS= read -r l; do
    [[ $l =~ $re ]] || continue
    d=${BASH_REMATCH[2]} t=${BASH_REMATCH[3]} act=${BASH_REMATCH[4]} id=${BASH_REMATCH[5]} text=${BASH_REMATCH[6]}
    [ "$act" = note ] || [ "$t" = --:-- ] && continue
    [[ "$d $t" > "$now_d $now_t" ]] && continue
    text=${text% (added *}; f=$C/${d:0:7}.md
    late=$(( ($(date +%s) - $(date -d "$d $t" +%s)) / 60 )); lt=""; [ $late -gt 60 ] && lt=" (late: was due $d $t)"
    if [ "$act" = ping ]; then
      # the one door (docs/concepts/telling.md): high, because a ping is due at a time someone chose
      ANNA_NOTIFY_FROM="clock #$id" "$(dirname "$(readlink -f "$0")")/anna-tell" send clock "⏰ Reminder (clock #$id, due $d $t): $text$lt" --importance high \
        --kind reminder && res="pinged $now_d $now_t" || res="ping FAILED $now_d $now_t"
    else
      p="Scheduled task from your clock (clock/${d:0:7}.md #$id, due $d $t$lt): $text
Do it within your headless permissions. If it needs $WHO or access you don't have, say so under a '## Needs action' heading with a ⛔ line."
      systemd-run --user -q --collect --unit "anna-clock-run-$id" \
        -p StandardOutput=append:"$ST/anna-run.log" -p StandardError=append:"$ST/anna-run.log" \
        "$BIN/anna-run" "$p" "clock-$id" && res="run started $now_d $now_t → journal/handoffs/$now_d-clock-$id.md" \
        || res="run FAILED to start $now_d $now_t"
    fi
    mark "$f" "$id" x "$res"; commit "$f" "#$id $res"; echo "#$id $res"
    [ "$act" = run ] && stream clock "#$id $res: $text"
  done ;;
*) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
