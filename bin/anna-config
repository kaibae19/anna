#!/usr/bin/env python3
"""anna-config — read Anna's configuration.

    anna-config KEY            print one value (dotted key, e.g. relay.brain_port); "~" in paths is expanded
    anna-config --dump         print the merged config as JSON (defaults + yours)
    anna-config --path         print which file is in use

File: $ANNA_CONFIG, else ~/.config/anna/anna.toml. Defaults: the scaffold's config/anna.example.toml, found next to this
script (../config) or in $ANNA_HOME/config. Unknown key → exit 2, so a typo never reads as an empty value.
"""
import json, os, sys, tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
DEFAULTS = [Path(os.environ["ANNA_HOME"]) / "config/anna.example.toml"] if os.environ.get("ANNA_HOME") else []
DEFAULTS += [HERE.parent / "config/anna.example.toml", Path.home() / ".local/share/anna/config/anna.example.toml"]
USER = Path(os.environ.get("ANNA_CONFIG", Path.home() / ".config/anna/anna.toml")).expanduser()


def merge(a: dict, b: dict) -> dict:
    out = dict(a)
    for k, v in b.items():
        out[k] = merge(out[k], v) if isinstance(v, dict) and isinstance(out.get(k), dict) else v
    return out


def load() -> dict:
    base = next((p for p in DEFAULTS if p.is_file()), None)
    cfg = tomllib.loads(base.read_text()) if base else {}
    if USER.is_file():
        cfg = merge(cfg, tomllib.loads(USER.read_text()))
    return cfg


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip()); return 2 if not argv else 0
    if argv[0] == "--path":
        print(USER if USER.is_file() else f"{USER} (missing: defaults only)"); return 0
    cfg = load()
    if argv[0] == "--dump":
        print(json.dumps(cfg, indent=2)); return 0
    v = cfg
    for part in argv[0].split("."):
        if not isinstance(v, dict) or part not in v:
            print(f"anna-config: no such key: {argv[0]}", file=sys.stderr); return 2
        v = v[part]
    if isinstance(v, bool):
        print("true" if v else "false")
    elif isinstance(v, (dict, list)):
        print(json.dumps(v))
    else:
        s = str(v)
        print(os.path.expanduser(s) if s.startswith("~") else s)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
