#!/usr/bin/env python3
"""anna-proposals: the changes Anna's nightly runs propose, kept with a status until someone decides.

  anna-proposals ingest HANDOFF...            copy each "## Proposed …" item of a handoff in (once; duplicates skipped)
  anna-proposals list [--all|--status S,S]    plain list (default: everything not yet decided or done)
  anna-proposals next                         the one to raise today, as "<id>\t<summary>" (nothing: none due)
  anna-proposals set ID STATUS [--said TEXT] [--note TEXT] [--commit SHA]
  anna-proposals raised-in [FILE|-]           a reply that raised today's proposal marks it raised (Stop hook)
  anna-proposals show ID                      one proposal in full

Status: open → raised → accepted → applied, or declined / later / dropped. `later` comes back after 7 days; a proposal
raised twice without an answer stays in the list but isn't raised again. Nothing here changes the record by itself: a
reviewed session applies accepted ones (skill /anna-proposals). The file: <record>/self/proposals.md
($ANNA_PROPOSALS overrides it). Docs: docs/reference/commands.md#anna-proposals.
"""
import hashlib, os, re, sys
from datetime import date, datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from anna_cfg import RECORD, TZ  # noqa: E402

FILE = Path(os.environ.get("ANNA_PROPOSALS", RECORD / "self/proposals.md"))
STATUSES = ["open", "raised", "accepted", "applied", "declined", "later", "dropped"]
LIVE = ["open", "raised", "accepted", "later"]
LATER_DAYS, RERAISE_DAYS, MAX_RAISES = 7, 3, 2
HEAD = """# Proposals

What the nightly runs (the evening fold, the dream) proposed to change in the record, kept until it's decided.
Nothing here is applied by itself: one is raised at a time in conversation, and a reviewed session applies the
accepted ones. Status: open → raised → accepted → applied, or declined / later / dropped. Tool: `anna-proposals`.
"""
SEC_RE = re.compile(r"^(?:#{2,3} |\*\*)Proposed\b.*$", re.M)
END_RE = re.compile(r"^(?:#{1,3} |\*\*[^*\n]+\*\*\s*$|\*\*⚠|FOLDED:)", re.M)
EMPTY_RE = re.compile(r"\b(nothing (to add|to log|new)|none[.;:]|none$)", re.I)
ID_RE = re.compile(r"\bp-[0-9a-f]{6}\b")
ITEM_RE = re.compile(r"^(?:[-*]|\d+\.)\s+")
P_RE = re.compile(r"^## (p-[0-9a-f]{6}) · ([a-z]+)\s*$", re.M)


def today() -> date:
    return datetime.now(TZ).date()


def norm(t: str) -> str:
    return re.sub(r"[^a-z0-9]+", "", t.lower())[:240]


def summary_of(body: str) -> str:
    lines = [l.strip() for l in body.strip().splitlines() if l.strip()]
    s = ITEM_RE.sub("", lines[0]).replace("**", "").strip() if lines else ""
    if len(lines) > 1 and (s.endswith(":") or len(s) < 40):
        s = s + " " + ITEM_RE.sub("", lines[1]).replace("**", "").strip()
    return s if len(s) <= 160 else s[:157].rstrip() + "…"


def load():
    if not FILE.is_file():
        return []
    text = FILE.read_text()
    out = []
    ms = list(P_RE.finditer(text))
    for i, m in enumerate(ms):
        chunk = text[m.end(): ms[i + 1].start() if i + 1 < len(ms) else len(text)].strip("\n")
        meta, body = {}, []
        lines = chunk.splitlines()
        j = 0
        while j < len(lines) and lines[j].startswith("- ") and ":" in lines[j]:
            k, v = lines[j][2:].split(":", 1)
            meta[k.strip()] = v.strip()
            j += 1
        body = "\n".join(lines[j:]).strip("\n")
        out.append({"id": m.group(1), "status": m.group(2), "meta": meta, "body": body})
    return out


def save(ps):
    parts = [HEAD]
    for p in ps:
        meta = "\n".join(f"- {k}: {v}" for k, v in p["meta"].items())
        parts.append(f"## {p['id']} · {p['status']}\n{meta}\n\n{p['body']}\n")
    FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = FILE.with_suffix(".md.tmp")
    tmp.write_text("\n".join(parts))
    tmp.replace(FILE)


def history(p):
    """[(date, status, rest)] from the history line."""
    out = []
    for h in filter(None, (x.strip() for x in p["meta"].get("history", "").split(";"))):
        m = re.match(r"(\d{4}-\d{2}-\d{2}) ([a-z]+)\b ?(.*)", h)
        if m:
            out.append((date.fromisoformat(m.group(1)), m.group(2), m.group(3)))
    return out


def note(p, status, rest=""):
    h = p["meta"].get("history", "")
    entry = f"{today():%F} {status}" + (f" {rest}" if rest else "")
    p["meta"]["history"] = f"{h}; {entry}" if h else entry
    p["status"] = status


def items_in(handoff: Path):
    text = handoff.read_text(errors="replace")
    for sec in SEC_RE.finditer(text):
        rest = text[sec.end():]
        end = END_RE.search(rest)
        body = rest[: end.start()] if end else rest
        cur = None
        for line in body.splitlines():
            if ITEM_RE.match(line):
                if cur:
                    yield "\n".join(cur).rstrip()
                cur = [line]
            elif cur is not None and (line.startswith((" ", "\t")) or not line.strip()):
                cur.append(line)
            elif cur is not None:          # prose at column 0 ends the list
                yield "\n".join(cur).rstrip()
                cur = None
        if cur:
            yield "\n".join(cur).rstrip()


def cmd_ingest(paths):
    ps = load()
    seen = {norm(p["body"]) for p in ps}
    added = 0
    touched = False
    for path in paths:
        h = Path(path)
        if not h.is_file():
            print(f"anna-proposals: no such file: {path}", file=sys.stderr)
            continue
        m = re.search(r"(\d{4}-\d{2}-\d{2})-([a-z0-9-]+)\.md$", h.name)
        src = f"{m.group(2)} {m.group(1)}" if m else h.name
        try:
            rel = h.resolve().relative_to(RECORD.resolve()).as_posix()
        except ValueError:
            rel = h.name
        for body in items_in(h):
            n = norm(body)
            if not n or n in seen:
                continue
            if len(body.splitlines()) == 1 and EMPTY_RE.search(body):
                continue                                   # "retrieval: nothing to add"
            refs = [p for p in ps if p["id"] in ID_RE.findall(body)]
            if refs:                                       # "still open: p-xxxxxx …" → noted on that one, not a new item
                for p in refs:
                    if p["status"] in LIVE:
                        note(p, p["status"], f"seen again ({src})")
                seen.add(n)
                added += 0
                touched = True
                continue
            seen.add(n)
            pid = "p-" + hashlib.sha1(n.encode()).hexdigest()[:6]
            p = {"id": pid, "status": "open", "body": body,
                 "meta": {"from": f"{src} · {rel}", "summary": summary_of(body)}}
            note(p, "open")
            ps.append(p)
            added += 1
    if added or touched:
        save(ps)
    print(f"proposals: {added} new, {sum(p['status'] in LIVE for p in ps)} live")


def due(p, t):
    hs = history(p)
    raises = [d for d, s, _ in hs if s == "raised"]
    last = hs[-1][0] if hs else t
    if p["status"] == "open":
        return True
    if p["status"] == "later":
        return (t - last).days >= LATER_DAYS
    if p["status"] == "raised":
        return len(raises) < MAX_RAISES and (t - last).days >= RERAISE_DAYS
    return False


def pick(ps):
    t = today()
    if any(d == t and s == "raised" for p in ps for d, s, _ in history(p)):
        return None                               # one a day
    for p in ps:
        if due(p, t):
            return p
    return None


def cmd_list(args):
    ps = load()
    if "--all" in args:
        want = STATUSES
    elif "--status" in args:
        want = args[args.index("--status") + 1].split(",")
    else:
        want = LIVE
    rows = [p for p in ps if p["status"] in want]
    if not rows:
        print("No proposals" + ("." if "--all" in args else " waiting."))
        return
    for p in rows:
        hs = history(p)
        print(f"{p['id']} · {p['status']:<8} · {p['meta'].get('from', '?').split(' · ')[0]} · {p['meta'].get('summary', '')}")
        if hs and hs[-1][2]:
            print(f"           last: {hs[-1][0]} {hs[-1][1]} {hs[-1][2]}")


def find(ps, pid):
    for p in ps:
        if p["id"] == pid or p["id"] == "p-" + pid:
            return p
    sys.exit(f"anna-proposals: no proposal {pid}")


def cmd_set(args):
    if len(args) < 2 or args[1] not in STATUSES:
        sys.exit(f"usage: anna-proposals set ID {'|'.join(STATUSES)} [--said TEXT] [--note TEXT] [--commit SHA]")
    ps = load()
    p = find(ps, args[0])
    rest = []
    for flag, fmt in (("--said", 'said "{}"'), ("--note", "({})"), ("--commit", "{}")):
        if flag in args:
            v = args[args.index(flag) + 1].replace(";", ",").replace("\n", " ")
            rest.append(fmt.format(v[:200]))
    note(p, args[1], " ".join(rest))
    save(ps)
    print(f"{p['id']} → {p['status']}")


def cmd_next():
    p = pick(load())
    if p:
        print(f"{p['id']}\t{p['meta'].get('summary', '')}")


def words(t):
    return set(re.findall(r"[a-z0-9][a-z0-9'-]{3,}", t.lower()))


def cmd_raised_in(src):
    reply = sys.stdin.read() if src in (None, "-") else Path(src).read_text()
    ps = load()
    p = pick(ps)
    if not p or "?" not in reply:
        return
    w = words(p["meta"].get("summary", ""))
    if w and (p["id"] in reply or len(w & words(reply)) >= max(2, len(w) // 2)):
        note(p, "raised")
        save(ps)
        print(f"{p['id']} raised")


def main(a):
    if not a or a[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if a else 2
    c, rest = a[0], a[1:]
    if c == "ingest":
        cmd_ingest(rest)
    elif c == "list":
        cmd_list(rest)
    elif c == "next":
        cmd_next()
    elif c == "set":
        cmd_set(rest)
    elif c == "raised-in":
        cmd_raised_in(rest[0] if rest else None)
    elif c == "show":
        p = find(load(), rest[0])
        print(f"## {p['id']} · {p['status']}\n" + "\n".join(f"- {k}: {v}" for k, v in p["meta"].items()) + f"\n\n{p['body']}")
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
