#!/bin/bash
# anna-run PROMPT [LABEL] — one headless Anna session (claude -p) with deny-by-default settings.
# Output: <record>/journal/handoffs/<date>-<LABEL>.md, committed (and pushed if the record has a remote). Log: <state>/anna-run.log.
# Auth: <paths.secrets>/claude-oauth if present (a long-lived token from `claude setup-token`), else the normal login.
# Alerts (anna-notify, if installed): a failed run, and ⛔ lines under "## Needs action" in a morning or clock run.
# $ANNA_ADD_DIR adds one extra readable directory (the evening run: the session drafts).
set -o pipefail
D=$(dirname "$(readlink -f "$0")"); cfg() { "$D/anna-config" "$1"; }
export PATH="$(cfg paths.bin):$HOME/.local/bin:$PATH" TZ; TZ=$(cfg anna.timezone)
export ANNA_HEADLESS=1          # the session hooks stay quiet for headless runs
R=$(cfg paths.record); SEC=$(cfg paths.secrets); PROMPT="${1:?usage: anna-run PROMPT [LABEL]}"; LABEL="${2:-run}"
DAY=$(date +%F); OUT="journal/handoffs/$DAY-$LABEL.md"; HOST=$(hostname -s)
if [ -s "$SEC/claude-oauth" ]; then export CLAUDE_CODE_OAUTH_TOKEN; CLAUDE_CODE_OAUTH_TOKEN=$(cat "$SEC/claude-oauth"); fi
cd "$R" || { echo "$(date -Is) no record at $R"; exit 2; }
remote=$(git remote | head -1)
[ -n "$remote" ] && { git pull -q --ff-only || { echo "$(date -Is) pull failed"; exit 1; }; }
mkdir -p journal/handoffs
args=(); [ -n "${ANNA_ADD_DIR:-}" ] && args+=(--add-dir "$ANNA_ADD_DIR")
model=$(cfg models.headless); [ -n "$model" ] && args+=(--model "$model")
res=$(timeout 1800 claude -p "$PROMPT" "${args[@]}" --settings "$HOME/.claude/anna-headless-settings.json" --output-format text </dev/null 2>&1); rc=$?
{ echo "> Headless Anna run on $HOST, $(date -Is), prompt: \`$PROMPT\`, exit $rc"; echo; echo "$res"; } > "$OUT"
# commit only this run's file: a bare commit would also take anything else that happens to be staged in the record
git add -- "$OUT" && git commit -qm "$HOST: $LABEL $DAY (headless, exit $rc)" -- "$OUT" && { [ -z "$remote" ] || git push -q; }
echo "$(date -Is) $LABEL exit=$rc -> $OUT"
"$D/anna-stream" add --from "headless $LABEL" "exit $rc → $OUT" 2>/dev/null || true
# the nightly runs' "Proposed" items go to self/proposals.md with a status, so they don't drop out with the next handoff
if [ "$rc" -eq 0 ] && [[ $LABEL = evening || $LABEL = dream ]]; then
  if pr=$(timeout 30 "$D/anna-proposals" ingest "$OUT" 2>&1); then
    echo "$(date -Is) $LABEL $pr"
    if [ -n "$(git status --porcelain -- self/proposals.md)" ]; then
      git add -- self/proposals.md && git commit -qm "$HOST: proposals from $LABEL $DAY" -- self/proposals.md && { [ -z "$remote" ] || git push -q; }
    fi
  else echo "$(date -Is) $LABEL ⚠ proposals not ingested: $pr"; fi
fi
command -v anna-notify >/dev/null || exit 0           # alerts: quiet unless something needs the user
export ANNA_NOTIFY_FROM="anna-run $LABEL"
if [ "$rc" -ne 0 ]; then anna-notify "⛔ anna-run $LABEL failed (exit $rc) on $HOST. Output: $OUT" || true
elif [[ $LABEL = morning || $LABEL = clock-* ]] && stop=$(sed -n '/^## Needs action/,/^## /p' "$OUT" | grep -m5 -E '^([-*] )?(\*\*)?⛔'); then
  anna-notify "⛔ $LABEL $DAY needs you:
$(cut -c1-300 <<<"$stop")
Full report: $OUT" || true
fi
