#!/usr/bin/env python3
"""anna-sense-send SENSE MESSAGE [--do log|tell|ask|check] [--importance low|normal|high] [--kind K] [--entity E]
   [--state S] [--context C] [--id ID] [--via http|drop] [--url URL] [--token-file F]

Send one event in the sense contract v1 to Anna's sense intake (anna-senses), the way any sense would. For writing and
testing a sense, and for local scripts that want to tell Anna something. Prints the JSON it sent and the intake's answer.
  --via http (default): POST <url>/sense/SENSE with the token from <paths.secrets>/sense-SENSE (`anna-senses token SENSE`
    makes it). URL default: http://<senses.listen>:<senses.port>.
  --via drop: write the event into the drop folder (same machine, same user).
"""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request
import uuid
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from anna_cfg import STATE, get, path  # noqa: E402

a = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
a.add_argument("sense")
a.add_argument("message")
a.add_argument("--do", default="log", choices=["log", "tell", "ask", "check"])
a.add_argument("--importance", default="normal", choices=["low", "normal", "high"])
for f in ("kind", "entity", "state", "context", "id"):
    a.add_argument(f"--{f}", default="")
a.add_argument("--via", default="http", choices=["http", "drop"])
a.add_argument("--url", default="")
a.add_argument("--token-file", default="")
o = a.parse_args()

ev = {"v": 1, "id": o.id or uuid.uuid4().hex[:12], "source": o.sense, "kind": o.kind, "entity": o.entity,
      "state": o.state, "message": o.message, "do": o.do, "importance": o.importance, "context": o.context,
      "time": datetime.now().astimezone().isoformat(timespec="seconds")}
body = json.dumps(ev)
print(body)

if o.via == "drop":
    d = path("senses.drop_dir", "") if get("senses.drop_dir") else STATE / "senses" / "inbox"
    d.mkdir(parents=True, exist_ok=True)
    tmp = d / f".{o.sense}.{ev['id']}.tmp"
    tmp.write_text(body)
    tmp.replace(d / f"{o.sense}.{ev['id']}.json")   # atomic: the intake never reads a half-written file
    print(f"dropped into {d}")
    sys.exit(0)

host = get("senses.listen", "127.0.0.1")
url = (o.url or f"http://{'127.0.0.1' if host in ('0.0.0.0', '::') else host}:{get('senses.port', 8793)}").rstrip("/")
tf = Path(o.token_file).expanduser() if o.token_file else path("paths.secrets", "~/.config/anna/secrets") / f"sense-{o.sense}"
try:
    token = tf.read_text().strip()
except OSError:
    sys.exit(f"anna-sense-send: no token at {tf} (make one: anna-senses token {o.sense})")
req = urllib.request.Request(f"{url}/sense/{o.sense}", data=body.encode(), method="POST",
                             headers={"Content-Type": "application/json", "Authorization": f"Bearer {token}"})
try:
    with urllib.request.urlopen(req, timeout=10) as r:
        print(r.status, r.read().decode())
except urllib.error.HTTPError as e:
    print(e.code, e.read().decode())
    sys.exit(1)
except OSError as e:
    sys.exit(f"anna-sense-send: can't reach the intake at {url}: {e}")
