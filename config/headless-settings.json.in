{
  "_comment": "Settings for Anna's headless runs (anna-run \u2192 claude -p). Deny by default: only what's listed runs. install.sh fills @RECORD@, @SECRETS@ and @HOME@ and installs this as ~/.claude/anna-headless-settings.json. Never add an HTTP-capable command (curl, wget, python, nc, bun): with the relay on, the brain's channel port takes local HTTP (docs/concepts/relay.md). A check you're missing belongs in anna-checks as a fixed section, not in this list. Agent(anna-*): the engines in agents/ (sensors: no Bash/Edit/Write of their own); a subagent inherits these rules (docs/concepts/security.md).",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(/@RECORD@/**)",
      "Write(/@RECORD@/**)",
      "mcp__merlin__*",
      "Bash(git -C @RECORD@ *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull --ff-only*)",
      "Bash(git push)",
      "Bash(set -o pipefail)",
      "Bash(date*)",
      "Bash(TZ=* date*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(hostname)",
      "Bash(uptime)",
      "Bash(anna-stream add *)",
      "Bash(anna-stream recent*)",
      "Bash(anna-clock list*)",
      "Bash(anna-clock due*)",
      "Bash(anna-checks*)",
      "Bash(anna-body --line)",
      "Bash(anna-relay status)",
      "Bash(anna-session-draft --mark-folded *)",
      "Bash(anna-rhythm*)",
      "Bash(backlog-age*)",
      "Agent(anna-memory)",
      "Agent(anna-interpretation)",
      "Agent(anna-epistemic)",
      "Agent(anna-action-gate)",
      "Agent(anna-goals)",
      "Agent(anna-curiosity)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git -C * clean *)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Read(/@SECRETS@/**)",
      "Bash(*@SECRETS@*)",
      "Bash(*claude-oauth*)"
    ]
  }
}
