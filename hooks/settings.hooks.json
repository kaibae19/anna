{
  "_comment": "Anna's Claude Code hooks. install.sh merges this into ~/.claude/settings.json (paths assume paths.bin = ~/bin). The bot gets the stream hook too (ANNA_ROLE=bot); headless runs set ANNA_HEADLESS=1 and the hooks stay quiet. Stop also runs anna-bot-reply-guard, which acts in the bot only (a Telegram turn can't end without a reply). anna-epistemic-hook (Stop: logs epistemic checks that were due and not run; PreToolUse on the relay reply: checks it first when engines.epistemic_relay = true). PostToolUse = anna-access (the record access log: paths and queries only). PreToolUse = the action gate (anna-gate-hook): in the brain, a state change needs a recent go from the anna-action-gate engine; the bot and headless runs pass.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/anna-session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/anna-session-draft",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/anna-stream hook",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/anna-stream hook",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/anna-bot-reply-guard",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/anna-epistemic-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/anna-idle-checkpoint",
            "timeout": 1800,
            "asyncRewake": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/anna-gate-hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_fakechat_fakechat__reply",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/anna-epistemic-hook",
            "timeout": 45
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Bash|mcp__merlin__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/anna-access hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
